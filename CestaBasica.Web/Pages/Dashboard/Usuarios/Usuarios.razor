@page "/usuarios"
@using System.Net.Http.Json
@using CestaBasica.Shared.DTOs
@using CestaBasica.Shared.Enums
@using Microsoft.AspNetCore.Components.Routing
@inject HttpClient Http

<div class="users-page">

    <div class="page-header">
        <div class="header-left">
            <div>
                <h1>Administração de Usuários</h1>
                <p>
                    Gerencie acessos, perfis e permissões dos usuários do sistema.
                </p>
            </div>
        </div>
        <button type="button" class="btn-primary" @onclick="AbrirCadastro">
            + Novo usuário
        </button>
    </div>

    @if (!string.IsNullOrWhiteSpace(mensagemFeedback))
    {
        <div class="alert @(erroFeedback ? "alert-danger" : "alert-success") mb-3">
            @mensagemFeedback
        </div>
    }

    <section class="filters-card">
        <div class="search-box">
            <label>Busca dinâmica</label>
            <input placeholder="Pesquisar por nome, e-mail ou perfil..."
                   @bind="busca"
                   @bind:event="oninput" />
        </div>
    </section>

    @if (exibirFormulario)
    {
        <section class="form-card">
            <div class="card-header">
                <div>
                    <h2>@(editando ? "Editar usuário" : "Cadastrar novo usuário")</h2>
                    <span>Defina os dados de acesso e permissões administrativas.</span>
                </div>
            </div>

            <div class="form-grid">
                <div class="form-group">
                    <label>Nome completo</label>
                    <input @bind="usuarioForm.Nome" placeholder="Digite o nome do usuário" />
                </div>

                <div class="form-group">
                    <label>E-mail</label>
                    <input @bind="usuarioForm.Email" placeholder="usuario@empresa.com.br" />
                </div>

                <div class="form-group">
                    <label>@(editando ? "Nova senha (opcional)" : "Senha")</label>
                    <input type="password" @bind="usuarioForm.Senha" placeholder="@(editando ? "Deixe em branco para manter" : "Digite a senha")" />
                </div>

                <div class="form-group">
                    <label>Perfil</label>
                    <select @bind="usuarioForm.Perfil">
                        <option value="Admin">Administrador</option>
                        <option value="Usuario">Operador / Usuário</option>
                    </select>
                </div>

                <div class="form-group">
                    <label>Status</label>
                    <select @bind="usuarioForm.Ativo">
                        <option value="true">Ativo</option>
                        <option value="false">Inativo</option>
                    </select>
                </div>
            </div>

            <div class="permissions-box">
                <h3>Controle de permissões</h3>

                <div class="permissions-grid">
                    <label><input type="checkbox" @bind="usuarioForm.Permissoes.Funcionarios" /> Funcionários</label>
                    <label><input type="checkbox" @bind="usuarioForm.Permissoes.Retiradas" /> Retiradas</label>
                    <label><input type="checkbox" @bind="usuarioForm.Permissoes.Notificacoes" /> Notificações</label>
                    <label><input type="checkbox" @bind="usuarioForm.Permissoes.Relatorios" /> Relatórios</label>
                    <label><input type="checkbox" @bind="usuarioForm.Permissoes.Usuarios" /> Usuários</label>
                </div>
            </div>

            <div class="form-actions">
                <button class="btn-secondary" @onclick="Cancelar">Cancelar</button>
                <button class="btn-primary" @onclick="SalvarUsuario">Salvar usuário</button>
            </div>
        </section>
    }

    <section class="table-card">
        <div class="table-header">
            <div>
                <h2>Usuários cadastrados</h2>
                <span>Listagem de usuários autorizados na plataforma.</span>
            </div>
        </div>

        <div class="table-responsive">
            <table>
                <thead>
                    <tr>
                        <th>Usuário</th>
                        <th>E-mail</th>
                        <th>Perfil</th>
                        <th>Status</th>
                        <th>Permissões</th>
                        <th>Ações</th>
                    </tr>
                </thead>

                <tbody>
                    @foreach (var usuario in UsuariosFiltrados)
                    {
                        <tr>
                            <td>
                                <strong>@usuario.Nome</strong>
                                <small>ID: @usuario.Id</small>
                            </td>

                            <td>@usuario.Email</td>

                            <td>
                                <span class="profile-badge @(usuario.Perfil == "Admin" ? "admin" : "operator")">
                                    @(usuario.Perfil == "Admin" ? "Administrador" : "Operador")
                                </span>
                            </td>

                            <td>
                                <span class="status-badge @(usuario.Ativo ? "active" : "inactive")">
                                    @(usuario.Ativo ? "Ativo" : "Inativo")
                                </span>
                            </td>

                            <td>
                                <div class="permissions-tags">
                                    @foreach (var permissao in usuario.Permissoes.ListarAtivas())
                                    {
                                        <span>@permissao</span>
                                    }
                                </div>
                            </td>

                            <td>
                                <div class="actions">
                                    <button title="Editar" @onclick="() => EditarUsuario(usuario)">✏️</button>
                                    <button title="Excluir" @onclick="() => ExcluirUsuario(usuario.Id)">🗑️</button>
                                </div>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </section>

</div>

@code {
    private string busca = "";
    private bool exibirFormulario = false;
    private bool editando = false;
    private string? mensagemFeedback;
    private bool erroFeedback = false;

    private UsuarioViewModel usuarioForm = new();
    private List<UsuarioViewModel> usuarios = new();

    protected override async Task OnInitializedAsync()
    {
        await CarregarUsuarios();
    }

    private async Task CarregarUsuarios()
    {
        try
        {
            var lista = await Http.GetFromJsonAsync<List<UsuarioListItemDto>>("api/usuarios/listar") ?? new();
            usuarios = lista.Select(u => new UsuarioViewModel
            {
                Id = u.Id,
                Nome = u.Nome,
                Email = u.Email,
                Perfil = u.Perfil,
                Ativo = u.Ativo,
                Permissoes = u.Perfil == "Admin"
                    ? PermissoesUsuario.AdminPadrao()
                    : PermissoesUsuario.OperadorPadrao()
            }).ToList();
        }
        catch (Exception ex)
        {
            erroFeedback = true;
            mensagemFeedback = $"Erro ao carregar usuários: {ex.Message}";
        }
    }

    private IEnumerable<UsuarioViewModel> UsuariosFiltrados =>
        usuarios.Where(u =>
            string.IsNullOrWhiteSpace(busca) ||
            u.Nome.Contains(busca, StringComparison.OrdinalIgnoreCase) ||
            u.Email.Contains(busca, StringComparison.OrdinalIgnoreCase) ||
            u.Perfil.Contains(busca, StringComparison.OrdinalIgnoreCase)
        );

    private void AbrirCadastro()
    {
        editando = false;
        mensagemFeedback = null;
        usuarioForm = new UsuarioViewModel
        {
            Perfil = "Usuario",
            Ativo = true,
            Permissoes = PermissoesUsuario.OperadorPadrao()
        };

        exibirFormulario = true;
    }

    private void EditarUsuario(UsuarioViewModel usuario)
    {
        editando = true;
        mensagemFeedback = null;

        usuarioForm = new UsuarioViewModel
        {
            Id = usuario.Id,
            Nome = usuario.Nome,
            Email = usuario.Email,
            Perfil = usuario.Perfil,
            Ativo = usuario.Ativo,
            Permissoes = usuario.Permissoes.Clone()
        };

        exibirFormulario = true;
    }

    private async Task SalvarUsuario()
    {
        mensagemFeedback = null;
        erroFeedback = false;

        var perfilEnum = usuarioForm.Perfil == "Admin" ? PerfilUsuario.Admin : PerfilUsuario.Usuario;

        HttpResponseMessage response;
        if (editando)
        {
            var dto = new UsuarioUpdateDto
            {
                Id = usuarioForm.Id,
                Nome = usuarioForm.Nome,
                Email = usuarioForm.Email,
                NovaSenha = string.IsNullOrWhiteSpace(usuarioForm.Senha) ? null : usuarioForm.Senha,
                Perfil = perfilEnum,
                Ativo = usuarioForm.Ativo
            };
            response = await Http.PutAsJsonAsync($"api/usuarios/{usuarioForm.Id}", dto);
        }
        else
        {
            var dto = new UsuarioCreateDto
            {
                Nome = usuarioForm.Nome,
                Email = usuarioForm.Email,
                Senha = usuarioForm.Senha,
                Perfil = perfilEnum,
                Ativo = usuarioForm.Ativo
            };
            response = await Http.PostAsJsonAsync("api/usuarios/criar", dto);
        }

        if (!response.IsSuccessStatusCode)
        {
            var erro = await response.Content.ReadFromJsonAsync<ErroApiDto>();
            erroFeedback = true;
            mensagemFeedback = erro?.Mensagem ?? "Erro ao salvar usuário.";
            return;
        }

        exibirFormulario = false;
        mensagemFeedback = editando ? "Usuário atualizado com sucesso." : "Usuário cadastrado com sucesso.";
        await CarregarUsuarios();
    }

    private async Task ExcluirUsuario(int id)
    {
        mensagemFeedback = null;
        var response = await Http.DeleteAsync($"api/usuarios/{id}");
        if (response.IsSuccessStatusCode)
        {
            erroFeedback = false;
            mensagemFeedback = "Usuário excluído com sucesso.";
            await CarregarUsuarios();
        }
        else
        {
            erroFeedback = true;
            mensagemFeedback = "Não foi possível excluir o usuário.";
        }
    }

    private void Cancelar()
    {
        exibirFormulario = false;
    }

    public class UsuarioViewModel
    {
        public int Id { get; set; }
        public string Nome { get; set; } = "";
        public string Email { get; set; } = "";
        public string Senha { get; set; } = "";
        public string Perfil { get; set; } = "Usuario";
        public bool Ativo { get; set; } = true;
        public PermissoesUsuario Permissoes { get; set; } = new();
    }

    public class PermissoesUsuario
    {
        public bool Funcionarios { get; set; }
        public bool Retiradas { get; set; }
        public bool Notificacoes { get; set; }
        public bool Relatorios { get; set; }
        public bool Usuarios { get; set; }

        public static PermissoesUsuario AdminPadrao() => new()
        {
            Funcionarios = true,
            Retiradas = true,
            Notificacoes = true,
            Relatorios = true,
            Usuarios = true
        };

        public static PermissoesUsuario OperadorPadrao() => new()
        {
            Funcionarios = true,
            Retiradas = true,
            Notificacoes = true
        };

        public List<string> ListarAtivas()
        {
            var lista = new List<string>();

            if (Funcionarios) lista.Add("Funcionários");
            if (Retiradas) lista.Add("Retiradas");
            if (Notificacoes) lista.Add("Notificações");
            if (Relatorios) lista.Add("Relatórios");
            if (Usuarios) lista.Add("Usuários");

            return lista;
        }

        public PermissoesUsuario Clone()
        {
            return new PermissoesUsuario
            {
                Funcionarios = Funcionarios,
                Retiradas = Retiradas,
                Notificacoes = Notificacoes,
                Relatorios = Relatorios,
                Usuarios = Usuarios
            };
        }
    }
}
